
# Airflow configuration
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.4.0
AIRFLOW_PROJ_DIR=.

# Generate a valid Fernet key before running
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Database passwords - replace with your own values
AIRFLOW_POSTGRES_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
RETAIL_POSTGRES_PASSWORD=CHANGE_ME_RETAIL_PASSWORD

# Airflow API authentication
AIRFLOW_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow web user
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_WEB_PASSWORD

# Optional settings
ENV_FILE_PATH=.env
_PIP_ADDITIONAL_REQUIREMENTS=
